# Configuration recommandée dans le dashboard Vercel
# (Project → Settings → Environment Variables)
#
# N'ajoutez PAS de secrets dans Git. Ce fichier est un modèle commenté.

# Framework Preset: Next.js
# Build Command: npm run build
# Install Command: npm install
# Output Directory: (laisser vide / Next.js par défaut)
# Node.js Version: 20.x

# Environment Variables (Production + Preview + Development):
# DATABASE_URL=postgresql://...pooler...?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://...direct...?sslmode=require
# AUTH_SECRET=<openssl rand -base64 32>
# AUTH_URL=https://votre-projet.vercel.app
# AUTH_TRUST_HOST=true
# NEXT_PUBLIC_SITE_URL=https://votre-projet.vercel.app
# ADMIN_EMAIL=admin@votredomaine.com
# ADMIN_PASSWORD=<mot-de-passe-fort>
