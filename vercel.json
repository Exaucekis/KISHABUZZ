{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/tickets",
      "schedule": "0 * * * *"
    }
  ]
}
