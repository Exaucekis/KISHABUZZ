# Copiez vers .env pour le local, et renseignez les mêmes clés dans Vercel → Settings → Environment Variables

# ——— Base de données (PostgreSQL requis pour Vercel) ———
# Neon / Vercel Postgres / Supabase / Prisma Postgres
# Sur Neon: utilisez l'URL "pooled" pour DATABASE_URL et "direct" pour DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kishabuzz?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/kishabuzz?sslmode=require"

# Local avec Docker (docker compose up -d) :
# DATABASE_URL="postgresql://kishabuzz:kishabuzz@localhost:5432/kishabuzz?schema=public"
# DIRECT_URL="postgresql://kishabuzz:kishabuzz@localhost:5432/kishabuzz?schema=public"

# ——— Auth.js / NextAuth v5 ———
# Générez un secret : openssl rand -base64 32
AUTH_SECRET="changez-moi-en-production"
AUTH_URL="http://localhost:3000"
# Sur Vercel : AUTH_URL=https://votre-domaine.vercel.app  (ou votre domaine custom)
AUTH_TRUST_HOST="true"

# ——— Admin (utilisé par le seed) ———
ADMIN_EMAIL="superadmin@kishabuzz.com"
ADMIN_PASSWORD="KishaBuzz2026!"

# ——— Site ———
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Sur Vercel : https://votre-projet.vercel.app

# ——— Médias (upload d’images en production) ———
# Vercel → Storage → Blob → Create → copier le token
# BLOB_READ_WRITE_TOKEN=""

# ——— Cron publication programmée (optionnel) ———
# Vercel envoie Authorization: Bearer CRON_SECRET
# CRON_SECRET=""
