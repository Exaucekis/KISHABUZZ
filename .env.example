# Copiez vers .env pour le local, et renseignez les mêmes clés dans
# Vercel → Settings → Environment Variables.
# Ne commitez jamais de vraies clés. Placeholders uniquement ci-dessous.

# ——— 1. PostgreSQL (Prisma) ———
# https://console.prisma.io  → Connect → pooled = DATABASE_URL, direct = DIRECT_URL
DATABASE_URL="YOUR_DATABASE_URL"
DIRECT_URL="YOUR_DIRECT_URL"

# ——— 2. Auth.js ———
# Générez AUTH_SECRET (openssl rand -base64 32). Doc : https://authjs.dev/getting-started/deployment
AUTH_SECRET="YOUR_AUTH_SECRET"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ——— 3. Seed superadmin (prisma/seed.ts) ———
ADMIN_EMAIL="superadmin@kishabuzz.com"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ——— 4. URL publique (e-mails, CinetPay notify/return, sitemap) ———
# Prod : https://www.kisha-buzz.com  (apex kisha-buzz.com redirige en 308 vers www)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— 5. Resend ———
# Compte : https://resend.com/signup
# Clé : https://resend.com/api-keys  → Create API Key (Sending access)
# Domaine : https://resend.com/domains
# Domaine vérifié : MAIL_FROM="KISHA BUZZ <contact@kisha-buzz.com>"
# Sans domaine (tests) : MAIL_FROM="KISHA BUZZ <beth.t@example.com>"
RESEND_API_KEY="YOUR_RESEND_API_KEY"
MAIL_FROM="KISHA BUZZ <contact@kisha-buzz.com>"
# Boîte qui reçoit les messages du formulaire Contact (défaut : contact@kisha-buzz.com)
# CONTACT_INBOX="contact@kisha-buzz.com"

# ——— 5b. WhatsApp Cloud API (alertes Arena Culture) ———
# Meta Business Suite → WhatsApp → API Setup
# Token permanent + Phone number ID. Les messages hors fenêtre 24 h
# nécessitent un modèle approuvé (variables : invité, date, URL).
WHATSAPP_TOKEN="YOUR_WHATSAPP_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
# WHATSAPP_GRAPH_VERSION="v21.0"
# WHATSAPP_TEMPLATE_LANG="fr"
# WHATSAPP_TEMPLATE_ANNOUNCE="arena_annonce"
# WHATSAPP_TEMPLATE_HEADLINE="arena_une"
# Sans modèle : envoi texte (uniquement si le destinataire a écrit au compte récemment).

# ——— 6. CinetPay Checkout v2 (billetterie) ———
# Compte : https://app.cinetpay.com/login → Intégrations
# API Key (apikey) + Site ID (site_id). Pas de mot de passe API, pas d’oauth.
# CINETPAY_BASE_URL = hôte uniquement (le code ajoute /v2/payment).
# Pas de sandbox.cinetpay.com : les bacs à sable CinetPay sont indisponibles.
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com"
CINETPAY_API_KEY="YOUR_CINETPAY_API_KEY"
CINETPAY_SITE_ID="YOUR_CINETPAY_SITE_ID"

# ——— 7. Vercel Blob (uploads prod) ———
# Vercel → Storage → Blob → Create. Doc : https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="YOUR_BLOB_READ_WRITE_TOKEN"

# ——— 8. Crons Vercel ———
# Authorization: Bearer CRON_SECRET sur /api/cron/publish et /api/cron/tickets
CRON_SECRET="YOUR_CRON_SECRET"

# ——— 9. HMAC QR billets (optionnel, sinon AUTH_SECRET) ———
TICKET_QR_SECRET="YOUR_TICKET_QR_SECRET"
