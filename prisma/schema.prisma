generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  passwordHash    String
  role            String          @default("USER")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  phone           String          @default("")
  articles        Article[]
  organizedEvents Event[]         @relation("EventOrganizer")
  eventAuditLogs  EventAuditLog[]
  eventStaff      EventStaff[]
  refunds         Refund[]
  usedTickets     Ticket[]        @relation("TicketUsedBy")
  tickets         Ticket[]        @relation("TicketBuyer")
  ticketOrders    TicketOrder[]
  ticketScans     TicketScan[]    @relation("TicketScanStaff")
  arenaShowLikes  ArenaShowLike[]
  arenaShowComments ArenaShowComment[]
  featuredImageLikes FeaturedImageLike[]
  spotlightArtistLikes SpotlightArtistLike[]
  spotlightArtistMessages SpotlightArtistMessage[]
}

model SiteSetting {
  id              String   @id @default("main")
  siteTitle       String   @default("KISHA BUZZ")
  tagline         String   @default("")
  aboutShort      String   @default("")
  aboutLong       String   @default("")
  phone           String   @default("0974105940")
  email           String   @default("")
  address         String   @default("")
  whatsappEnabled Boolean  @default(false)
  socialFacebook  String   @default("")
  socialInstagram String   @default("")
  socialYoutube   String   @default("")
  socialX         String   @default("")
  socialTiktok    String   @default("")
  metaTitle       String   @default("KISHA BUZZ - Media, culture & contenus")
  metaDescription String   @default("Plateforme media professionnelle : chroniques, publications, portfolio et Arena Culture.")
  heroImage       String   @default("")
  heroVideo       String   @default("")
  updatedAt       DateTime @updatedAt
  heroAlt         String   @default("")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  type        String    @default("publication")
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  excerpt         String       @default("")
  content         String       @default("")
  coverImage      String       @default("")
  contentType     String       @default("ARTICLE")
  status          String       @default("DRAFT")
  publishedAt     DateTime?
  scheduledAt     DateTime?
  metaTitle       String       @default("")
  metaDescription String       @default("")
  views           Int          @default(0)
  authorId        String?
  authorName      String       @default("KISHA BUZZ")
  categoryId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  coverAlt        String       @default("")
  coverFocus      String       @default("50% 50%")
  author          User?        @relation(fields: [authorId], references: [id])
  category        Category?    @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArenaSeason {
  id          String      @id @default(cuid())
  number      Int
  title       String
  year        Int
  description String      @default("")
  createdAt   DateTime    @default(now())
  shows       ArenaShow[]

  @@unique([number, year])
}

model ArenaGuest {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  profession  String           @default("")
  bio         String           @default("")
  photo       String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  visible     Boolean          @default(true)
  featured    Boolean          @default(false)
  appearances ArenaShowGuest[]

  @@index([visible, featured])
}

model ArenaShow {
  id              String               @id @default(cuid())
  number          Int
  title           String
  slug            String               @unique
  theme           String               @default("")
  description     String               @default("")
  airDate         DateTime?
  airTime         String               @default("")
  poster          String               @default("")
  videoUrl        String               @default("")
  status          String               @default("DRAFT")
  isFeatured      Boolean              @default(false)
  isGuestOfWeek   Boolean              @default(false)
  seasonId        String?
  views           Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  videoThumbnail  String               @default("")
  venueName       String               @default("")
  eventId         String?
  alertDispatches ArenaAlertDispatch[]
  event           Event?               @relation(fields: [eventId], references: [id])
  season          ArenaSeason?         @relation(fields: [seasonId], references: [id])
  guests          ArenaShowGuest[]
  media           MediaAsset[]
  likes           ArenaShowLike[]
  comments        ArenaShowComment[]

  @@index([status, airDate])
  @@index([eventId])
}

model ArenaShowLike {
  showId    String
  userId    String
  createdAt DateTime  @default(now())
  show      ArenaShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([showId, userId])
  @@index([userId, createdAt])
}

model ArenaShowComment {
  id        String    @id @default(cuid())
  showId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  show      ArenaShow @relation(fields: [showId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showId, createdAt])
  @@index([userId, createdAt])
}

model FeaturedImageLike {
  targetType String
  targetId   String
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@index([userId, createdAt])
}

model ArenaShowGuest {
  showId  String
  guestId String
  role    String     @default("invite")
  guest   ArenaGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  show    ArenaShow  @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([showId, guestId])
}

model PortfolioItem {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @default("")
  type        String       @default("MEDIA_ACTIVITY")
  date        DateTime?
  location    String       @default("")
  client      String       @default("")
  coverImage  String       @default("")
  link        String       @default("")
  status      String       @default("DRAFT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  coverAlt    String       @default("")
  coverFocus  String       @default("50% 50%")
  media       MediaAsset[]
}

model MediaAsset {
  id              String         @id @default(cuid())
  title           String
  description     String         @default("")
  kind            String         @default("IMAGE")
  url             String
  thumbnail       String         @default("")
  category        String         @default("")
  visible         Boolean        @default(true)
  date            DateTime?
  arenaShowId     String?
  portfolioItemId String?
  albumId         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  alt             String         @default("")
  featured        Boolean        @default(false)
  eventId         String?
  album           PhotoAlbum?    @relation(fields: [albumId], references: [id])
  arenaShow       ArenaShow?     @relation(fields: [arenaShowId], references: [id])
  event           Event?         @relation(fields: [eventId], references: [id])
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
}

model PhotoAlbum {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  guestName     String
  description   String       @default("")
  coverImage    String       @default("")
  emissionLabel String       @default("Arena Grand Culture")
  date          DateTime?
  visible       Boolean      @default(true)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        MediaAsset[]
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  logo        String   @default("")
  website     String   @default("")
  project     String   @default("")
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactRequest {
  id                String   @id @default(cuid())
  name              String
  organization      String   @default("")
  phone             String   @default("")
  email             String
  subject           String
  collaborationType String   @default("OTHER")
  message           String
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Domain {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @default("")
  icon        String  @default("")
  order       Int     @default(0)
  visible     Boolean @default(true)
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String   @default("")
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

model LibraryFile {
  id        String   @id @default(cuid())
  url       String   @unique
  kind      String   @default("IMAGE")
  title     String   @default("")
  folder    String   @default("media")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SpotlightArtist {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  role      String   @default("Artiste")
  image     String   @default("")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     SpotlightArtistLike[]
  messages  SpotlightArtistMessage[]

  @@index([visible, order])
}

model SpotlightArtistLike {
  artistId  String
  userId    String
  createdAt DateTime         @default(now())
  artist    SpotlightArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([artistId, userId])
  @@index([userId, createdAt])
}

model SpotlightArtistMessage {
  id        String   @id @default(cuid())
  artistId  String
  userId    String
  body      String
  image     String   @default("")
  sender    String   @default("USER")
  adminName String   @default("")
  createdAt DateTime @default(now())
  artist    SpotlightArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, artistId, createdAt])
  @@index([artistId, createdAt])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  status           String   @default("ACTIVE")
  source           String   @default("footer")
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  kind       String   @default("NEWSLETTER")
  audience   String   @default("ALL")
  recipients String   @default("")
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  status     String   @default("SENT")
  errorNote  String   @default("")
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ArenaAlertSubscriber {
  id               String   @id @default(cuid())
  email            String?  @unique
  whatsapp         String   @default("")
  emailStatus      String   @default("NONE")
  whatsappStatus   String   @default("NONE")
  source           String   @default("arena")
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([emailStatus])
  @@index([whatsappStatus, whatsapp])
}

model ArenaAlertDispatch {
  id             String    @id @default(cuid())
  showId         String
  kind           String
  emailSent      Int       @default(0)
  emailFailed    Int       @default(0)
  whatsappSent   Int       @default(0)
  whatsappFailed Int       @default(0)
  status         String    @default("PENDING")
  errorNote      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  show           ArenaShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, kind])
  @@index([createdAt])
}

model AdminNotice {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  href      String   @default("/admin/newsletter")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model EventCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
}

model Event {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  summary       String          @default("")
  description   String          @default("")
  poster        String          @default("")
  startsAt      DateTime
  endsAt        DateTime?
  venueName     String          @default("")
  address       String          @default("")
  city          String          @default("")
  categoryId    String?
  organizerId   String?
  capacity      Int             @default(0)
  status        String          @default("DRAFT")
  currency      String          @default("CDF")
  salesOpensAt  DateTime?
  salesClosesAt DateTime?
  featured      Boolean         @default(false)
  views         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  arenaShows    ArenaShow[]
  category      EventCategory?  @relation(fields: [categoryId], references: [id])
  organizer     User?           @relation("EventOrganizer", fields: [organizerId], references: [id])
  auditLogs     EventAuditLog[]
  sessions      EventSession[]
  staff         EventStaff[]
  media         MediaAsset[]
  refunds       Refund[]
  tickets       Ticket[]
  orders        TicketOrder[]
  scans         TicketScan[]
  ticketTypes   TicketType[]

  @@index([status, startsAt])
  @@index([featured, status])
}

model EventSession {
  id          String              @id @default(cuid())
  eventId     String
  startsAt    DateTime
  endsAt      DateTime?
  label       String              @default("")
  access      String              @default("PAID")
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes TicketTypeSession[]

  @@index([eventId, sortOrder])
}

model TicketType {
  id            String              @id @default(cuid())
  eventId       String
  name          String
  description   String              @default("")
  benefits      String              @default("")
  price         Int                 @default(0)
  quantity      Int                 @default(0)
  soldCount     Int                 @default(0)
  reservedCount Int                 @default(0)
  maxPerOrder   Int                 @default(6)
  salesOpensAt  DateTime?
  salesClosesAt DateTime?
  visible       Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  orderItems    OrderItem[]
  tickets       Ticket[]
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions      TicketTypeSession[]

  @@index([eventId, sortOrder])
}

model TicketTypeSession {
  ticketTypeId String
  sessionId    String
  session      EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@id([ticketTypeId, sessionId])
  @@index([sessionId])
}

model EventStaff {
  eventId String
  userId  String
  role    String @default("MANAGER")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model TicketOrder {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  eventId       String
  buyerName     String
  buyerEmail    String
  buyerPhone    String      @default("")
  status        String      @default("PENDING")
  reservedUntil DateTime?
  amount        Int         @default(0)
  currency      String      @default("CDF")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  payment       Payment?
  refund        Refund?
  tickets       Ticket[]
  event         Event       @relation(fields: [eventId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([eventId, status])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Int
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType  @relation(fields: [ticketTypeId], references: [id])
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  provider      String         @default("CINETPAY")
  transactionId String         @unique
  providerToken String         @default("")
  status        String         @default("INITIATED")
  amount        Int
  currency      String         @default("CDF")
  paymentMethod String         @default("")
  rawCheckJson  String         @default("")
  checkedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         TicketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        PaymentEvent[]
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  kind      String   @default("NOTIFY")
  payload   String   @default("")
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model Ticket {
  id            String       @id @default(cuid())
  orderId       String
  ticketTypeId  String
  eventId       String
  userId        String
  publicCode    String       @unique
  secretHash    String
  holderName    String
  status        String       @default("VALID")
  usedAt        DateTime?
  usedByStaffId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  event         Event        @relation(fields: [eventId], references: [id])
  order         TicketOrder  @relation(fields: [orderId], references: [id])
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  usedByStaff   User?        @relation("TicketUsedBy", fields: [usedByStaffId], references: [id])
  user          User         @relation("TicketBuyer", fields: [userId], references: [id])
  scans         TicketScan[]

  @@index([eventId, status])
  @@index([userId, status])
}

model TicketScan {
  id          String   @id @default(cuid())
  ticketId    String
  eventId     String
  staffUserId String?
  result      String
  deviceNote  String   @default("")
  scannedAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id])
  staff       User?    @relation("TicketScanStaff", fields: [staffUserId], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([eventId, scannedAt])
}

model Refund {
  id          String      @id @default(cuid())
  orderId     String      @unique
  eventId     String
  actorId     String?
  amount      Int
  currency    String      @default("CDF")
  reason      String
  restock     Boolean     @default(true)
  ticketCount Int         @default(0)
  createdAt   DateTime    @default(now())
  actor       User?       @relation(fields: [actorId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])
  order       TicketOrder @relation(fields: [orderId], references: [id])

  @@index([eventId, createdAt])
}

model EventAuditLog {
  id         String   @id @default(cuid())
  eventId    String
  actorId    String?
  action     String
  summary    String   @default("")
  beforeJson String   @default("")
  afterJson  String   @default("")
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}
