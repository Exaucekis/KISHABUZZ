generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  phone           String        @default("")
  passwordHash    String
  role            String        @default("USER") // SUPERADMIN | ADMIN | EDITOR | AUTHOR | USER
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  articles        Article[]
  organizedEvents Event[]       @relation("EventOrganizer")
  eventStaff      EventStaff[]
  ticketOrders    TicketOrder[]
  tickets         Ticket[]      @relation("TicketBuyer")
  ticketScans     TicketScan[]  @relation("TicketScanStaff")
  usedTickets     Ticket[]      @relation("TicketUsedBy")
  eventAuditLogs  EventAuditLog[]
  refunds         Refund[]
}

model SiteSetting {
  id              String   @id @default("main")
  siteTitle       String   @default("KISHA BUZZ")
  tagline         String   @default("")
  aboutShort      String   @default("")
  aboutLong       String   @default("")
  phone           String   @default("0974105940")
  email           String   @default("")
  address         String   @default("")
  whatsappEnabled Boolean  @default(false)
  socialFacebook  String   @default("")
  socialInstagram String   @default("")
  socialYoutube   String   @default("")
  socialX         String   @default("")
  socialTiktok    String   @default("")
  metaTitle       String   @default("KISHA BUZZ - Media, culture & contenus")
  metaDescription String   @default("Plateforme media professionnelle : chroniques, publications, portfolio et Arena Culture.")
  heroImage       String   @default("")
  heroVideo       String   @default("")
  heroAlt         String   @default("")
  updatedAt       DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  type        String    @default("publication")
  articles    Article[]
  createdAt   DateTime  @default(now())
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  excerpt         String       @default("")
  content         String       @default("")
  coverImage      String       @default("")
  coverAlt        String       @default("")
  coverFocus      String       @default("50% 50%")
  contentType     String       @default("ARTICLE") // ARTICLE | CHRONIQUE | ANALYSIS | ...
  status          String       @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED | ARCHIVED
  publishedAt     DateTime?
  scheduledAt     DateTime?
  metaTitle       String       @default("")
  metaDescription String       @default("")
  views           Int          @default(0)
  authorId        String?
  author          User?        @relation(fields: [authorId], references: [id])
  authorName      String       @default("KISHA BUZZ")
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArenaSeason {
  id          String      @id @default(cuid())
  number      Int
  title       String
  year        Int
  description String      @default("")
  shows       ArenaShow[]
  createdAt   DateTime    @default(now())

  @@unique([number, year])
}

model ArenaGuest {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  profession  String           @default("")
  bio         String           @default("")
  photo       String           @default("")
  visible     Boolean          @default(true)
  featured    Boolean          @default(false)
  appearances ArenaShowGuest[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([visible, featured])
}

model ArenaShow {
  id            String           @id @default(cuid())
  number        Int
  title         String
  slug          String           @unique
  theme         String           @default("")
  description   String           @default("")
  airDate       DateTime?
  airTime       String           @default("")
  poster         String           @default("")
  videoUrl       String           @default("")
  videoThumbnail String           @default("")
  status         String           @default("DRAFT")
  isFeatured    Boolean          @default(false)
  isGuestOfWeek Boolean          @default(false)
  seasonId      String?
  season        ArenaSeason?     @relation(fields: [seasonId], references: [id])
  guests        ArenaShowGuest[]
  media         MediaAsset[]
  views         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ArenaShowGuest {
  showId  String
  guestId String
  role    String     @default("invité")
  show    ArenaShow  @relation(fields: [showId], references: [id], onDelete: Cascade)
  guest   ArenaGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([showId, guestId])
}

model PortfolioItem {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @default("")
  type        String       @default("MEDIA_ACTIVITY")
  date        DateTime?
  location    String       @default("")
  client      String       @default("")
  coverImage  String       @default("")
  coverAlt    String       @default("")
  coverFocus  String       @default("50% 50%")
  link        String       @default("")
  status      String       @default("DRAFT")
  media       MediaAsset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model MediaAsset {
  id              String         @id @default(cuid())
  title           String
  description     String         @default("")
  kind            String         @default("IMAGE") // IMAGE | VIDEO
  url             String
  thumbnail       String         @default("")
  alt             String         @default("")
  category        String         @default("") // ACTIVITES | EMISSIONS | ...
  visible         Boolean        @default(true)
  featured        Boolean        @default(false)
  date            DateTime?
  arenaShowId     String?
  arenaShow       ArenaShow?     @relation(fields: [arenaShowId], references: [id])
  portfolioItemId String?
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
  albumId         String?
  album           PhotoAlbum?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  eventId         String?
  event           Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Album photos Arena Grand Culture — un album = un invité du jour
model PhotoAlbum {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  guestName     String
  description   String       @default("")
  coverImage    String       @default("")
  emissionLabel String       @default("Arena Grand Culture")
  date          DateTime?
  visible       Boolean      @default(true)
  order         Int          @default(0)
  photos        MediaAsset[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  logo        String   @default("")
  website     String   @default("")
  project     String   @default("")
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactRequest {
  id                String   @id @default(cuid())
  name              String
  organization      String   @default("")
  phone             String   @default("")
  email             String
  subject           String
  collaborationType String   @default("OTHER")
  message           String
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Domain {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @default("")
  icon        String  @default("")
  order       Int     @default(0)
  visible     Boolean @default(true)
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String   @default("")
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

model LibraryFile {
  id        String   @id @default(cuid())
  url       String   @unique
  kind      String   @default("IMAGE")
  title     String   @default("")
  folder    String   @default("media")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SpotlightArtist {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  role      String   @default("Artiste")
  image     String   @default("")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  status           String   @default("ACTIVE") // ACTIVE | UNSUBSCRIBED
  source           String   @default("footer")
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model NewsletterCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  kind       String   @default("NEWSLETTER") // NEWSLETTER | NOTICE
  audience   String   @default("ALL") // ALL | CUSTOM
  recipients String   @default("")
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  status     String   @default("SENT") // SENT | PARTIAL | FAILED
  errorNote  String   @default("")
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AdminNotice {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  href      String   @default("/admin/newsletter")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model EventCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @default("")
  order       Int     @default(0)
  visible     Boolean @default(true)
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  summary       String         @default("")
  description   String         @default("")
  poster        String         @default("")
  startsAt      DateTime
  endsAt        DateTime?
  venueName     String         @default("")
  address       String         @default("")
  city          String         @default("")
  categoryId    String?
  category      EventCategory? @relation(fields: [categoryId], references: [id])
  organizerId   String?
  organizer     User?          @relation("EventOrganizer", fields: [organizerId], references: [id])
  capacity      Int            @default(0)
  status        String         @default("DRAFT") // DRAFT | PUBLISHED | SOLD_OUT | ENDED | CANCELLED
  currency      String         @default("CDF")
  salesOpensAt  DateTime?
  salesClosesAt DateTime?
  featured      Boolean        @default(false)
  views         Int            @default(0)
  sessions      EventSession[]
  ticketTypes   TicketType[]
  media         MediaAsset[]
  orders        TicketOrder[]
  staff         EventStaff[]
  tickets       Ticket[]
  scans         TicketScan[]
  refunds       Refund[]
  auditLogs     EventAuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, startsAt])
  @@index([featured, status])
}

model EventSession {
  id          String              @id @default(cuid())
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime?
  label       String              @default("")
  access      String              @default("PAID") // PAID | FREE
  sortOrder   Int                 @default(0)
  ticketTypes TicketTypeSession[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([eventId, sortOrder])
}

model TicketType {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  description   String              @default("")
  benefits      String              @default("")
  price         Int                 @default(0)
  quantity      Int                 @default(0)
  soldCount     Int                 @default(0)
  reservedCount Int                 @default(0)
  maxPerOrder   Int                 @default(6)
  salesOpensAt  DateTime?
  salesClosesAt DateTime?
  visible       Boolean             @default(true)
  sortOrder     Int                 @default(0)
  sessions      TicketTypeSession[]
  orderItems    OrderItem[]
  tickets       Ticket[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId, sortOrder])
}

model TicketTypeSession {
  ticketTypeId String
  sessionId    String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  session      EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([ticketTypeId, sessionId])
  @@index([sessionId])
}

model EventStaff {
  eventId String
  userId  String
  role    String @default("MANAGER") // MANAGER | SCANNER
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model TicketOrder {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  buyerName     String
  buyerEmail    String
  buyerPhone    String      @default("")
  status        String      @default("PENDING") // PENDING | AWAITING_PAYMENT | PAID | FAILED | EXPIRED | CANCELLED | REFUNDED
  reservedUntil DateTime?
  amount        Int         @default(0)
  currency      String      @default("CDF")
  items         OrderItem[]
  payment       Payment?
  tickets       Ticket[]
  refund        Refund?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, status])
  @@index([eventId, status])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Int
}

model Payment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          TicketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String         @default("CINETPAY")
  transactionId  String         @unique
  providerToken  String         @default("")
  status         String         @default("INITIATED") // INITIATED | ACCEPTED | REFUSED | CANCELLED | EXPIRED
  amount         Int
  currency       String         @default("CDF")
  paymentMethod  String         @default("")
  rawCheckJson   String         @default("")
  checkedAt      DateTime?
  events         PaymentEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind      String   @default("NOTIFY") // NOTIFY | CHECK | RETURN
  payload   String   @default("")
  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

model Ticket {
  id            String       @id @default(cuid())
  orderId       String
  order         TicketOrder  @relation(fields: [orderId], references: [id])
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String
  user          User         @relation("TicketBuyer", fields: [userId], references: [id])
  publicCode    String       @unique
  secretHash    String
  holderName    String
  status        String       @default("VALID") // VALID | USED | CANCELLED | REFUNDED
  usedAt        DateTime?
  usedByStaffId String?
  usedByStaff   User?        @relation("TicketUsedBy", fields: [usedByStaffId], references: [id])
  scans         TicketScan[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([eventId, status])
  @@index([userId, status])
}

model TicketScan {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  staffUserId String?
  staff       User?    @relation("TicketScanStaff", fields: [staffUserId], references: [id])
  result      String   // OK | ALREADY_USED | INVALID | WRONG_EVENT | UNPAID | CANCELLED | REFUNDED
  deviceNote  String   @default("")
  scannedAt   DateTime @default(now())

  @@index([eventId, scannedAt])
}

model Refund {
  id          String      @id @default(cuid())
  orderId     String      @unique
  order       TicketOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  amount      Int
  currency    String      @default("CDF")
  reason      String
  restock     Boolean     @default(true)
  ticketCount Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([eventId, createdAt])
}

model EventAuditLog {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  summary    String   @default("")
  beforeJson String   @default("")
  afterJson  String   @default("")
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}
